* text=auto eol=lf

# ---- Git LFS ----
# Media that can realistically get large: event photography, video, recordings,
# design sources, fonts.
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.mov    filter=lfs diff=lfs merge=lfs -text
*.webm   filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.pdf    filter=lfs diff=lfs merge=lfs -text
*.zip    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text
*.fig    filter=lfs diff=lfs merge=lfs -text
*.woff2  filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text

# ...except the site's own icons, which stay ordinary files on purpose. A build that
# deploys from Git does not fetch LFS objects by default, and an LFS pointer served
# as a favicon is a broken favicon. These are a few KB; they do not need LFS.
/public/favicon.ico        -filter -diff -merge binary
/public/favicon.svg        text
/public/apple-touch-icon.png -filter -diff -merge binary
/public/icon-512.png       -filter -diff -merge binary
