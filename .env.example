# Cloudflare — DNS for sobor.io
# Create at https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit zone DNS". Permissions needed:
#   Zone → DNS   → Edit      (to create the records)
#   Zone → Zone  → Read      (to look up the sobor.io zone id)
# Zone Resources: Include → Specific zone → sobor.io
CLOUDFLARE_API_TOKEN=

# Optional: skips the zone lookup if you already have it
# (Cloudflare dashboard → sobor.io → Overview → right rail → Zone ID)
CLOUDFLARE_ZONE_ID=
